      { "name": "refraction",     "min": 0.010,"max": 0.045,"distribution": "uniform",  "note": "屈折の強さ" },
      { "name": "driftSpeed",     "min": 0.05, "max": 0.40, "distribution": "uniform",  "note": "粒の漂う速さ" },
