      { "name": "flowSpeed",      "min": 0.02,  "max": 0.22, "distribution": "uniform",   "note": "流動速度" },
      { "name": "intensity",      "min": 0.35,  "max": 0.75, "distribution": "centered",  "note": "全体の強さ" },
      { "name": "pattern",        "min": 0.0,   "max": 2.0,  "distribution": "quantized", "steps": 3, "note": "0=線状 1=同心円 2=格子" }
