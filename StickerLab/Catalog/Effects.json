[
  {
    "id": "flat.foil.v1",
    "version": 1,
    "displayName": "フラット（ホロ箔）",
    "material": "flat",
    "shaderFunction": "fx_flatFoil",
    "fallbackEffectID": null,
    "paramSchema": [
      { "name": "bandDensity",    "min": 2.0,   "max": 9.0,  "distribution": "uniform",   "note": "虹帯の本数" },
      { "name": "hueOffset",      "min": 0.0,   "max": 1.0,  "distribution": "uniform",   "note": "色相の開始位置" },
      { "name": "bandAngle",      "min": 0.0,   "max": 3.14159, "distribution": "uniform","note": "帯の向き" },
