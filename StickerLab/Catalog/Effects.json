      { "id": "prism",  "displayName": "プリズム", "weight": 5.0,
        "paramOverrides": { "intensity": [0.88, 1.0], "bandDensity": [6.0, 14.0], "sparkleDensity": [32.0, 54.0] } }
    ]
  },
  {
    "id": "puffy.gloss.v1",
    "version": 1,
    "displayName": "ぷっくり",
