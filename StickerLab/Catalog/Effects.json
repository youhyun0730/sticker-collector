      { "name": "tintHue",        "min": 0.0,  "max": 1.0,  "distribution": "uniform",  "note": "縁にのる色味" },
      { "name": "refraction",     "min": 0.004,"max": 0.020,"distribution": "uniform",  "note": "厚みによる像のずれ" },
      { "name": "innerShadow",    "min": 0.10, "max": 0.42, "distribution": "uniform",  "note": "内側の陰の濃さ" }
    ],
    "grades": [
      { "id": "normal", "displayName": "ノーマル", "weight": 72.0, "paramOverrides": {} },
      { "id": "shiny",  "displayName": "シャイニー", "weight": 23.0,
        "paramOverrides": { "specIntensity": [0.78, 0.95], "height": [0.75, 1.0] } },
      { "id": "prism",  "displayName": "プリズム", "weight": 5.0,
        "paramOverrides": { "specIntensity": [0.90, 1.0], "height": [0.85, 1.0], "rimWidth": [0.35, 0.55] } }
    ]
  },
  {
    "id": "water.capsule.v1",
    "version": 1,
    "displayName": "水入り",
    "material": "liquid",
    "shaderFunction": "fx_waterCapsule",
    "fallbackEffectID": "puffy.gloss.v1",
    "paramSchema": [
      { "name": "viscosity",      "min": 0.25, "max": 1.00, "distribution": "uniform",  "note": "粘度。揺れ戻りの遅さ" },
