    "grades": [
      { "id": "normal", "displayName": "ノーマル", "weight": 68.0, "paramOverrides": {} },
      { "id": "shiny",  "displayName": "シャイニー", "weight": 24.0,
        "paramOverrides": { "glitterMix": [0.70, 0.95], "particleDensity": [9.0, 16.0] } },
      { "id": "aurora", "displayName": "オーロラ", "weight": 8.0,
        "paramOverrides": { "glitterMix": [0.80, 1.0], "particleDensity": [12.0, 20.0], "refraction": [0.035, 0.060] } }
